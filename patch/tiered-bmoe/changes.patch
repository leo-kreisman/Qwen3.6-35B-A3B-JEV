diff --git a/core/src/moe/tiered_codec.h b/core/src/moe/tiered_codec.h
new file mode 100644
--- /dev/null
+++ b/core/src/moe/tiered_codec.h
@@ -0,0 +1,88 @@
+#pragma once
+#include <cstddef>
+#include <cstdint>
+#include <cstring>
+#include <array>
+#if defined(__GNUC__) && (defined(__x86_64__) || defined(__i386__))
+#include <tmmintrin.h>
+#endif
+
+// Q4_K metadata is retained verbatim. Each block chooses one of these nibble
+// codebooks; 256 two-bit indices replace 256 four-bit indices. 81 vs 144 bytes.
+// This is a lossy STORAGE codec, not a native Q2_K arithmetic format.
+namespace jev_tiered {
+inline constexpr uint8_t books[][4] = {
+    {0,5,10,15}, {1,5,9,13}, {2,6,10,14}, {3,6,9,12},
+    {4,6,8,10}, {5,7,9,11}, {6,8,10,12}, {4,7,10,13},
+    {0,3,6,9}, {6,9,12,15}, {0,2,4,6}, {9,11,13,15},
+    {2,5,8,11}, {4,7,10,15}, {0,5,8,11}, {5,8,11,14}
+};
+inline constexpr auto pair_luts = [] {
+    std::array<std::array<uint8_t,16>,16> result{};
+    for(unsigned b=0;b<16;++b) for(unsigned j=0;j<16;++j)
+        result[b][j]=books[b][j&3] | (books[b][j>>2]<<4);
+    return result;
+}();
+#if defined(__GNUC__) && (defined(__x86_64__) || defined(__i386__))
+__attribute__((target("ssse3"))) inline bool expand_simd(const uint8_t * src, uint8_t * dst, size_t blocks) {
+    const __m128i mask=_mm_set1_epi8(15);
+    for(size_t b=0;b<blocks;++b,src+=81,dst+=144) {
+        if(src[16]>=16) return false;
+        _mm_storeu_si128(reinterpret_cast<__m128i *>(dst),_mm_loadu_si128(reinterpret_cast<const __m128i *>(src)));
+        __m128i lut=_mm_loadu_si128(reinterpret_cast<const __m128i *>(pair_luts[src[16]].data()));
+        for(size_t j=0;j<64;j+=16) {
+            __m128i v=_mm_loadu_si128(reinterpret_cast<const __m128i *>(src+17+j));
+            __m128i lo=_mm_shuffle_epi8(lut,_mm_and_si128(v,mask));
+            __m128i hi=_mm_shuffle_epi8(lut,_mm_and_si128(_mm_srli_epi16(v,4),mask));
+            _mm_storeu_si128(reinterpret_cast<__m128i *>(dst+16+2*j),_mm_unpacklo_epi8(lo,hi));
+            _mm_storeu_si128(reinterpret_cast<__m128i *>(dst+32+2*j),_mm_unpackhi_epi8(lo,hi));
+        }
+    }
+    return true;
+}
+#endif
+inline bool expand(const uint8_t * src, size_t stored, uint8_t * dst, size_t raw) {
+    if (raw % 144 || stored != raw / 144 * 81) return false;
+#if defined(__GNUC__) && (defined(__x86_64__) || defined(__i386__))
+    if(__builtin_cpu_supports("ssse3")) return expand_simd(src,dst,raw/144);
+#endif
+    for (size_t b = 0; b < raw / 144; ++b, src += 81, dst += 144) {
+        if (src[16] >= 16) return false;
+        std::memcpy(dst, src, 16);
+        const auto & lut=pair_luts[src[16]];
+        for (size_t j=0;j<64;++j) {
+            dst[16+2*j] = lut[src[17+j]&15];
+            dst[17+2*j] = lut[src[17+j]>>4];
+        }
+    }
+    return true;
+}
+inline void pack(const uint8_t * src, size_t blocks, uint8_t * dst) {
+    uint8_t maps[16][16];
+    uint8_t errors[16][16];
+    for (unsigned c=0;c<16;++c) for (int x=0;x<16;++x) {
+        unsigned best=0; int cost=1000;
+        for (unsigned k=0;k<4;++k) {
+            int d=x-books[c][k];
+            if (d*d < cost) {cost=d*d; best=k;}
+        }
+        maps[c][x]=best; errors[c][x]=cost;
+    }
+    for (size_t b=0;b<blocks;++b,src+=144,dst+=81) {
+        unsigned hist[16]={};
+        for (size_t j=16;j<144;++j) {++hist[src[j]&15]; ++hist[src[j]>>4];}
+        unsigned best=0, cost=~0u;
+        for (unsigned c=0;c<16;++c) {
+            unsigned e=0;
+            for (unsigned x=0;x<16;++x) e+=hist[x]*errors[c][x];
+            if(e<cost){cost=e;best=c;}
+        }
+        std::memcpy(dst,src,16); dst[16]=best;
+        const auto * m=maps[best];
+        for(size_t j=0;j<64;++j) {
+            uint8_t a=src[16+2*j], d=src[17+2*j];
+            dst[17+j]=m[a&15] | (m[a>>4]<<2) | (m[d&15]<<4) | (m[d>>4]<<6);
+        }
+    }
+}
+}
diff --git a/core/src/moe/tiered_reader.h b/core/src/moe/tiered_reader.h
new file mode 100644
--- /dev/null
+++ b/core/src/moe/tiered_reader.h
@@ -0,0 +1,27 @@
+#pragma once
+#include "../io/file_reader.h"
+#include <atomic>
+#include <string>
+#include <unordered_map>
+#include <vector>
+
+namespace bmoe {
+class TieredReader {
+public:
+    bool open(const std::string & path, const std::string & source, int lanes, bool direct,
+              const std::unordered_map<uint64_t, uint64_t> & allowed);
+    bool contains(uint64_t off) const { return entries_.find(off) != entries_.end(); }
+    long long read(int lane, void * dst, uint64_t off, size_t raw);
+    long long read_bytes() const { return reader_.read_bytes(); }
+    long long syscall_ns() const { return reader_.syscall_ns(); }
+    long long expand_ns() const { return expand_ns_.load(); }
+    bool direct() const { return reader_.direct(); }
+    bool reopen() { return reader_.reopen(); }
+private:
+    struct Entry { uint64_t source, offset, raw, stored, codec; };
+    std::unordered_map<uint64_t, Entry> entries_;
+    std::vector<std::vector<uint8_t>> scratch_;
+    FileReader reader_;
+    std::atomic<long long> expand_ns_{0};
+};
+}
diff --git a/core/src/moe/tiered_reader.cpp b/core/src/moe/tiered_reader.cpp
new file mode 100644
--- /dev/null
+++ b/core/src/moe/tiered_reader.cpp
@@ -0,0 +1,67 @@
+#include "tiered_reader.h"
+#include "tiered_codec.h"
+#include <algorithm>
+#include <chrono>
+#include <cstdio>
+#include <cstring>
+#include <fstream>
+#include <limits>
+
+namespace bmoe {
+bool TieredReader::open(const std::string & path, const std::string & source, int lanes, bool direct,
+                        const std::unordered_map<uint64_t, uint64_t> & allowed) {
+    auto fail = [](const char * reason) { std::fprintf(stderr,"bmoe: tiered pack: %s\n",reason); return false; };
+    const uint16_t endian=1;
+    if (*reinterpret_cast<const uint8_t *>(&endian)!=1) return fail("little-endian host required");
+    std::ifstream f(path,std::ios::binary), src(source,std::ios::binary);
+    if(!f || !src) return fail("cannot open pack or source");
+    f.seekg(0,std::ios::end); uint64_t file_size=f.tellg(); f.seekg(0);
+    src.seekg(0,std::ios::end); uint64_t source_size=src.tellg();
+    char magic[8]; uint64_t size,hash,n;
+    f.read(magic,8); f.read(reinterpret_cast<char *>(&size),8);
+    f.read(reinterpret_cast<char *>(&hash),8); f.read(reinterpret_cast<char *>(&n),8);
+    if(!f || std::memcmp(magic,"JEVTIER1",8) || size!=source_size || n>allowed.size() ||
+       file_size<32 || n>(file_size-32)/40) return fail("invalid header or model size mismatch");
+    uint64_t fingerprint=14695981039346656037ull;
+    auto feed=[&](uint64_t off,size_t bytes) {
+        std::vector<char> b(bytes); src.seekg(off); src.read(b.data(),bytes);
+        if(!src) return false;
+        for(unsigned char c:b) fingerprint=(fingerprint^c)*1099511628211ull;
+        return true;
+    };
+    if(!feed(0,std::min<uint64_t>(size,65536))) return fail("source read failed");
+    if(size>=4096) for(unsigned i=0;i<16;++i)
+        if(!feed((size-4096)*i/15,4096)) return fail("source read failed");
+    if(fingerprint!=hash) return fail("source fingerprint mismatch");
+    size_t max_stored=0;
+    uint64_t previous_end=32+n*40;
+    for(uint64_t i=0;i<n;++i) {
+        Entry e{}; static_assert(sizeof(e)==40,"pack entry size");
+        f.read(reinterpret_cast<char *>(&e),sizeof(e));
+        auto a=allowed.find(e.source);
+        if(!f || a==allowed.end() || e.raw!=a->second || e.raw%144 || e.codec!=1 ||
+           e.stored!=e.raw/144*81 || e.offset%4096 || e.offset<previous_end ||
+           e.offset>file_size || e.stored>file_size-e.offset || entries_.count(e.source))
+            return fail("invalid or incompatible extent table");
+        previous_end=e.offset+e.stored;
+        entries_.emplace(e.source,e); max_stored=std::max<size_t>(max_stored,e.stored);
+    }
+    scratch_.assign(lanes,std::vector<uint8_t>(max_stored));
+    if(!reader_.open(path,lanes,direct,4096,max_stored+8192)) return fail("reader open failed");
+    std::fprintf(stderr,"bmoe: LOSSY tiered storage ON: %zu cold Q4_K slices; expanded cache unchanged\n",entries_.size());
+    return true;
+}
+
+long long TieredReader::read(int lane, void * dst, uint64_t off, size_t raw) {
+    auto it=entries_.find(off);
+    if(it==entries_.end() || it->second.raw!=raw || lane<0 || size_t(lane)>=scratch_.size()) return -1;
+    const auto & e=it->second;
+    auto & buf=scratch_[lane];
+    long long count=reader_.read(lane,buf.data(),e.offset,e.stored);
+    if(count<0) return -1;
+    auto start=std::chrono::steady_clock::now();
+    bool ok=jev_tiered::expand(buf.data(),e.stored,static_cast<uint8_t *>(dst),raw);
+    expand_ns_+=std::chrono::duration_cast<std::chrono::nanoseconds>(std::chrono::steady_clock::now()-start).count();
+    return ok ? count : -1;
+}
+}
